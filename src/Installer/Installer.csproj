<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net472: the Windows build players run (ships with Windows 10/11, no extra runtime needed).
    net8.0: same code, used to test the installer on Linux during development.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <AssemblyName>DNFTM-ModInstaller</AssemblyName>
    <RootNamespace>DNFTMInstaller</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
